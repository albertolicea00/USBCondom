<Window x:Class="USBGuard.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="USB Guard" Width="1000" Height="700" MinWidth="800" MinHeight="550" Background="#F3F3F3" FontFamily="Segoe UI Variable, Segoe UI" Loaded="OnLoaded" Closed="OnClosed">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="18,10"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DDDDDD"/></Style>
 </Window.Resources>
 <Grid Margin="32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel><TextBlock Text="USB Guard" FontSize="32" FontWeight="SemiBold"/><TextBlock Text="Inspect removable drives. Import through a local scanning area." Foreground="#666666" Margin="0,8,0,24"/></StackPanel>
 <Border Grid.Row="1" Background="#FFF4CE" CornerRadius="8" Padding="16" Margin="0,0,0,20"><TextBlock Text="Execution blocking is not enforced. Configure Windows application control before using this on a production workstation." TextWrapping="Wrap"/></Border>
 <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <ListBox x:Name="Drives" SelectionChanged="OnSelection" DisplayMemberPath="Name" BorderThickness="0" Padding="10"/>
 <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="24"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock x:Name="Heading" Text="Connect a removable drive" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="Status" Text="Waiting for a device…" TextWrapping="Wrap" Margin="0,12,0,16"/><WrapPanel Margin="0,0,0,16"><Button x:Name="Inspect" Content="Inspect" Click="OnInspect" IsEnabled="False"/><Button x:Name="Import" Content="Import and scan" Click="OnImport" IsEnabled="False"/><Button Content="Eject instructions" Click="OnEject"/></WrapPanel></StackPanel><ListBox x:Name="Files" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto"/></DockPanel></Border>
 </Grid><TextBlock Grid.Row="3" Text="No files are opened from USB Guard. A successful scan does not guarantee a file is harmless." Foreground="#666666" Margin="0,20,0,0"/>
 </Grid>
</Window>
